# Backend runtime
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=500
HF_TOKEN=
HF_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp

# Required for production (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/truthlens?retryWrites=true&w=majority
MONGODB_DATABASE=truthlens

# Required for production (S3-compatible object storage, e.g. Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
